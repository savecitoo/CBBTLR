S' -> S
S -> E
E -> E + T #binary_expr | E - T #binary_expr | T
T -> T * F #binary_expr | T / F #binary_expr | F
F -> + F #unary_expr | - F #unary_expr | P ^ F #binary_expr | P
P -> ( E ) #group | Id #identifier | Int #int_literal
Token:
+ : \+
- : -
* : \*
/: /
^ : \^
( : \(
) : \)
Int : [0-9][0-9]*
Id : [a-zA-Z][a-zA-Z]*
WS : [ \t\n]+ skip