dimension Massa            with unit kg
dimension Lunghezza        with unit m
dimension Tempo            with unit s
dimension Temperatura      with unit K
dimension QuantitaSostanza with unit mol

unit J  = kg * m ^ 2 / s ^ 2
unit Pa = kg / (m * s ^ 2)
unit R  = 8314 / 1000 * J / (mol * K)
unit L  = 1 / 1000 * m ^ 3

def pressione(n : mol, t : K, v : L) : Pa {
    return n * R * t / v
}

def main(n : mol, t : K, v : L) : Pa {
    return pressione(n, t, v)
}
