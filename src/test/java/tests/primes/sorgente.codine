def resto(n : Num, i : Num) : Num {
    var r = n
    while (r >= i) {
        r = r - i
    }
    return r
}

def isPrime(n : Num) : Num {
    var i = 2
    var r = 0
    if (n <= 1) {
        return 0
    }
    while (i <= n / 2) {
        r = resto(n, i)
        if (r <= 0) {
            return 0
        }
        i = i + 1
    }
    return 1
}

def main(n : Num) : Num {
    return isPrime(n)
}